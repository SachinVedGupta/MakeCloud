# Copy to .env.hosted on the server. Keep secrets outside Git; chmod 600.
MAKECLOUD_HOST=makecloud.example.com
MAKECLOUD_HOST_DATA_DIR=/var/lib/makecloud
MAKECLOUD_DOCKER_GID=999
MAKECLOUD_API_TOKEN=
MAKECLOUD_ENCRYPTION_KEY=
MAKECLOUD_ENABLE_APPLY=false
# Public signup requires working TLS SMTP. Start with invite-only smoke tests.
MAKECLOUD_REGISTRATION=invite
MAKECLOUD_INVITE_CODE=
MAKECLOUD_SMTP_HOST=
MAKECLOUD_SMTP_PORT=587
MAKECLOUD_SMTP_USER=
MAKECLOUD_SMTP_PASSWORD=
MAKECLOUD_MAIL_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
MAKECLOUD_AWS_PRINCIPAL_ARN=
MAKECLOUD_AWS_TEMPLATE_URL=
MAKECLOUD_AWS_BROKER_REGION=us-east-1
# Broker credentials only, preferably host IAM role. Never customer access keys.
# If using host IAM role, ensure the API container can reach instance credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MAKECLOUD_GOOGLE_CLIENT_ID=
MAKECLOUD_GOOGLE_CLIENT_SECRET=
MAKECLOUD_AZURE_TENANT_ID=
MAKECLOUD_AZURE_PRINCIPAL_ID=
MAKECLOUD_AZURE_CLIENT_ID=
MAKECLOUD_AZURE_CLIENT_SECRET=
MAKECLOUD_COMMAND_TIMEOUT=300
MAKECLOUD_TERRAFORM_IMAGE=hashicorp/terraform:1.9.8
