# Default is a clearly labeled storage-only demo; no resources are provisioned.
MAKECLOUD_MODE=demo
# Live mode uses the OpenAI-compatible chat completions API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
# Set both backend and Next.js to the same random token when hosting remotely.
MAKECLOUD_API_TOKEN=
MAKECLOUD_BACKEND_URL=http://127.0.0.1:5000
# Enable only in an isolated, trusted operator environment with cloud credentials.
MAKECLOUD_ENABLE_APPLY=false
MAKECLOUD_DATA_DIR=.makecloud
# Required for remote frontend access; HTTP Basic username is operator.
MAKECLOUD_OPERATOR_PASSWORD=
