# Local blueprints work without AI or cloud credentials. Demo never provisions.
MAKECLOUD_MODE=demo
MAKECLOUD_AUTH_MODE=operator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
# Apply is a separate explicit opt-in. Real plans also need cloud identity.
MAKECLOUD_ENABLE_APPLY=false
MAKECLOUD_DATA_DIR=.makecloud
MAKECLOUD_RUNNER=local
MAKECLOUD_COMMAND_TIMEOUT=300
MAKECLOUD_TERRAFORM_IMAGE=hashicorp/terraform:1.9.8
# Required on BOTH frontend and backend for remote hosting.
MAKECLOUD_API_TOKEN=
MAKECLOUD_BACKEND_URL=http://127.0.0.1:5010
# Operator-mode remote frontend authentication uses username operator.
MAKECLOUD_OPERATOR_PASSWORD=
# Account mode: invitation rollout or verified public signup, secure Lax cookies.
MAKECLOUD_INVITE_CODE=
MAKECLOUD_SECURE_COOKIES=true
MAKECLOUD_CONNECTIONS_FILE=
# Fernet key; keep outside the state volume for hosted/account-mode deployments.
# Blank generates a protected local key for operator demo mode.
MAKECLOUD_ENCRYPTION_KEY=
# Optional measured estimates. Requires the Infracost executable on the backend.
# The CLI reads the private plan locally and requests cloud pricing parameters.
INFRACOST_API_KEY=
# Alternative: current Infracost v2.4.2+ CLI with service/personal access token.
INFRACOST_CLI_AUTHENTICATION_TOKEN=
# Local launcher only: separate free ports if the defaults are occupied.
MAKECLOUD_DEV_API_PORT=5010
MAKECLOUD_DEV_UI_PORT=3000
# Hosted browser onboarding. See HOSTING.md and .env.hosted.example.
MAKECLOUD_PUBLIC_URL=
MAKECLOUD_REGISTRATION=invite
MAKECLOUD_AWS_PRINCIPAL_ARN=
MAKECLOUD_AWS_TEMPLATE_URL=
MAKECLOUD_GOOGLE_CLIENT_ID=
MAKECLOUD_GOOGLE_CLIENT_SECRET=
MAKECLOUD_AZURE_TENANT_ID=
MAKECLOUD_AZURE_PRINCIPAL_ID=
MAKECLOUD_AZURE_CLIENT_ID=
MAKECLOUD_AZURE_CLIENT_SECRET=
MAKECLOUD_SMTP_HOST=
MAKECLOUD_SMTP_PORT=587
MAKECLOUD_SMTP_USER=
MAKECLOUD_SMTP_PASSWORD=
MAKECLOUD_MAIL_FROM=
