# Server-only secrets. Copy to ignored .env.hcp, never commit real values.
MAKECLOUD_MODE=live
MAKECLOUD_AUTH_MODE=accounts
MAKECLOUD_RUNNER=hcp
MAKECLOUD_SECURE_COOKIES=true
MAKECLOUD_REGISTRATION=invite
MAKECLOUD_MAX_ACCOUNTS=10
MAKECLOUD_INVITE_CODE=
MAKECLOUD_ENCRYPTION_KEY=
MAKECLOUD_API_TOKEN=
MAKECLOUD_DATABASE_URL=
MAKECLOUD_HCP_TOKEN=
MAKECLOUD_HCP_ORGANIZATION=for_hack_uoft
MAKECLOUD_HCP_PROJECT_ID=
MAKECLOUD_HCP_PROJECT_NAME=MakeCloud
MAKECLOUD_ENABLE_APPLY=false
MAKECLOUD_PUBLIC_URL=
OPENAI_API_KEY=
# On Vercel only: MAKECLOUD_BACKEND_URL and the same installation API token.
# Optional: HTTPS transactional mail API, for public email verification/reset.
MAKECLOUD_RESEND_API_KEY=
MAKECLOUD_MAIL_FROM=
